<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            These values are forced so a developer's .env can never redirect
            the test suite to a real database, queue, filesystem or API.
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" force="true"/>
        <env name="APP_URL" value="http://localhost" force="true"/>
        <env name="APP_DEBUG" value="false" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="CACHE_DRIVER" value="array" force="true"/>
        <env name="DATABASE_URL" value="" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_FOREIGN_KEYS" value="true" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="1" force="true"/>
        <env name="DB_USERNAME" value="" force="true"/>
        <env name="DB_PASSWORD" value="" force="true"/>
        <env name="DB_SOCKET" value="" force="true"/>
        <env name="BROADCAST_DRIVER" value="&quot;null&quot;" force="true"/>
        <env name="FILESYSTEM_DISK" value="local" force="true"/>
        <env name="LOG_CHANNEL" value="&quot;null&quot;" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="QUEUE_FAILED_DRIVER" value="&quot;null&quot;" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="SICOES_REFRESH_DOWNLOADS" value="false" force="true"/>
        <env name="SICOES_ASSISTED_DOWNLOAD" value="false" force="true"/>
        <env name="SICOES_AI_PROVIDER" value="anthropic" force="true"/>
        <env name="SICOES_USE_GEMINI_VALIDATION" value="false" force="true"/>
        <env name="GEMINI_API_KEY" value="" force="true"/>
        <env name="GEMINI_VERIFY_SSL" value="true" force="true"/>
        <env name="GEMINI_DEBUG_SSL" value="false" force="true"/>
        <env name="ANTHROPIC_API_KEY" value="" force="true"/>
    </php>
</phpunit>
