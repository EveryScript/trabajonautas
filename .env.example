APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

ADMIN_ROLE=ADMIN
USER_ROLE=USER
CLIENT_ROLE=CLIENT
SUPPORT_PHONE=

SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PHONE=
SEED_USER_NAME=Usuario
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_PHONE=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=trabajonautas
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_RETRY_AFTER=7600
SESSION_DRIVER=database
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

SICOES_REFRESH_DOWNLOADS=true
SICOES_ASSISTED_DOWNLOAD=true
SICOES_PROCESS_TIMEOUT=7200
SICOES_PROCESS_IDLE_TIMEOUT=240
SICOES_MANUAL_DOWNLOAD_TIMEOUT_MS=600000
SICOES_MANUAL_DOWNLOAD_DIR=
SICOES_NODE_PATH=
SICOES_BROWSER_PATH=
SICOES_CDP_PORT=9222
SICOES_CDP_URL=http://127.0.0.1:9222
SICOES_USE_GEMINI_VALIDATION=false

SICOES_AI_PROVIDER=anthropic
SICOES_AI_RETRIES=2
SICOES_AI_TIMEOUT=120
SICOES_AI_MAX_TEXT_CHARS=250000

# Mantener true; false solo se admite en local/testing.
EVALUAR_VERIFY_SSL=true
EVALUAR_CA_BUNDLE=
EVALUAR_TIMEOUT=30
EVALUAR_CONNECT_TIMEOUT=10
EVALUAR_MAX_REDIRECTS=3

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Mantener true; false solo se admite en local/testing.
GEMINI_VERIFY_SSL=true
GEMINI_CA_BUNDLE=
GEMINI_TIMEOUT=60
GEMINI_CONNECT_TIMEOUT=10
GEMINI_MAX_DESCRIPTION_CHARS=6000
# Solo habilita diagnosticos TLS saneados en local/testing.
GEMINI_DEBUG_SSL=false

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=4000
